            "source": {
              "expression": [
                "let",
                "    Origen = Csv.Document(File.Contents(RutaDatos & \"\\resultados\\psi.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),",
                "    Tipos = Table.TransformColumnTypes(Encabezados, {{\"canal\", type text}, {\"variable\", type text}, {\"psi\", type number}}, \"en-US\"),",
                "    Paso0 = Table.TransformColumns(Tipos, {{\"variable\", each Record.FieldOrDefault([score_originacion = \"Score de originación\", ingreso_mensual = \"Ingreso mensual\", edad = \"Edad\", monto_desembolsado = \"Monto desembolsado\", plazo_meses = \"Plazo\"], _, _), type text}}),",
                "    Paso1 = Table.AddColumn(Paso0, \"Diagnóstico\", each if [psi] < 0.1 then \"Estable\" else if [psi] < 0.25 then \"Revisar\" else \"Cambio significativo\", type text)",
                "in",
                "    Paso1"
              ],
