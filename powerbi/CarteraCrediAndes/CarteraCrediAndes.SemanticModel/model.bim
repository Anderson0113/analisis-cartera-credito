            "name": "roll_rates",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Origen = Csv.Document(File.Contents(RutaDatos & \"\\resultados\\roll_rates.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),",
                "    Despivote = Table.UnpivotOtherColumns(Encabezados, {\"estado_mora\"}, \"estado_hasta\", \"probabilidad\"),",
                "    Renombre = Table.RenameColumns(Despivote, {{\"estado_mora\", \"estado_desde\"}}),",
                "    Tipos = Table.TransformColumnTypes(Renombre, {{\"estado_desde\", Int64.Type}, {\"estado_hasta\", Int64.Type}, {\"probabilidad\", type number}}, \"en-US\"),",
                "    Etiquetas = {\"Al día\", \"1-30\", \"31-60\", \"61-90\", \"91-120\", \"121-150\", \"151-180\", \"Castigo\", \"Pagado\"},",
                "    Desde = Table.AddColumn(Tipos, \"Mes actual\", each Etiquetas{[estado_desde]}, type text),",
                "    Hasta = Table.AddColumn(Desde, \"Mes siguiente\", each Etiquetas{[estado_hasta]}, type text)",
                "in",
                "    Hasta"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "Medidas",
        "columns": [
          {
            "name": "_",
            "dataType": "string",
            "isHidden": true,
            "lineageTag": "4528da21-1153-4826-b56d-ca5e197aecaf",
            "sourceColumn": "_",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "c88f17ba-f8d2-479b-9fdc-08a680e03fe7",
        "measures": [
          {
            "name": "Cartera Bruta",
            "displayFolder": "Cartera",
            "expression": "CALCULATE ( SUM ( desempeno_mensual[saldo_capital] ), desempeno_mensual[estado_mora] <= 6 )",
            "formatString": "\\$ #,0",
            "lineageTag": "8d9c3f67-6b1c-42af-a046-a7b7df2eebba"
          },
          {
            "name": "Cartera Vencida 30+",
            "displayFolder": "Cartera",
            "expression": "CALCULATE ( SUM ( desempeno_mensual[saldo_capital] ), desempeno_mensual[estado_mora] >= 2, desempeno_mensual[estado_mora] <= 6 )",
            "formatString": "\\$ #,0",
            "lineageTag": "eda7e217-1aef-4595-a0ae-bca09726ffec"
          },
          {
            "name": "Cartera Mora 90+",
            "displayFolder": "Cartera",
            "expression": "CALCULATE ( SUM ( desempeno_mensual[saldo_capital] ), desempeno_mensual[estado_mora] >= 4, desempeno_mensual[estado_mora] <= 6 )",
            "formatString": "\\$ #,0",
            "lineageTag": "d8badce3-d76f-48f4-a2b0-1accfdc75622"
          },
          {
            "name": "ICV 30+",
            "displayFolder": "Indicadores",
            "expression": "DIVIDE ( [Cartera Vencida 30+], [Cartera Bruta] )",
            "formatString": "0.0 %;-0.0 %;0.0 %",
            "lineageTag": "c4218bbb-f832-45d2-8f3a-c8ad4a2975a3"
          },
          {
            "name": "Mora 90+",
            "displayFolder": "Indicadores",
            "expression": "DIVIDE ( [Cartera Mora 90+], [Cartera Bruta] )",
            "formatString": "0.0 %;-0.0 %;0.0 %",
            "lineageTag": "d202b49a-5354-4886-9d05-853d01b31fe6"
          },
          {
            "name": "Créditos Activos",
            "displayFolder": "Cartera",
            "expression": "CALCULATE ( DISTINCTCOUNT ( desempeno_mensual[id_credito] ), desempeno_mensual[estado_mora] <= 6 )",
            "formatString": "#,0",
            "lineageTag": "794af516-d466-4cc2-81c1-edc718d5472d"
          },
          {
            "name": "Castigos",
            "displayFolder": "Cartera",
            "expression": "CALCULATE ( SUM ( desempeno_mensual[saldo_capital] ), desempeno_mensual[estado_mora] = 7 )",
            "formatString": "\\$ #,0",
            "lineageTag": "1f2a1b18-099b-463c-a7cb-9fd40f14d5bc"
          },
          {
            "name": "Desembolsos",
            "displayFolder": "Cartera",
            "expression": "CALCULATE ( SUM ( creditos[monto_desembolsado] ), USERELATIONSHIP ( creditos[fecha_desembolso], Calendario[Fecha] ) )",
            "formatString": "\\$ #,0",
            "lineageTag": "a3ef7043-39b3-4f0c-a483-70c6205f50c0"
          },
          {
            "name": "Último Corte",
            "displayFolder": "Indicadores",
            "expression": "CALCULATE ( MAX ( desempeno_mensual[fecha_corte] ), ALL ( Calendario ) )",
            "formatString": "mmm yyyy",
            "lineageTag": "e5e147c0-3799-4f88-b8e9-e9a68197f1f5"
          },
          {
            "name": "Cartera Bruta (último corte)",
            "displayFolder": "Último corte",
            "expression": "VAR u = [Último Corte] RETURN CALCULATE ( [Cartera Bruta], Calendario[Fecha] = u )",
            "formatString": "\\$ #,0",
            "lineageTag": "516869d4-c17c-49a6-b022-91061985311e"
          },
          {
            "name": "ICV 30+ (último corte)",
            "displayFolder": "Último corte",
            "expression": "VAR u = [Último Corte] RETURN CALCULATE ( [ICV 30+], Calendario[Fecha] = u )",
            "formatString": "0.0 %;-0.0 %;0.0 %",
            "lineageTag": "525ada6d-7919-4eb4-98cd-eeaef37352ae"
          },
          {
            "name": "Mora 90+ (último corte)",
            "displayFolder": "Último corte",
            "expression": "VAR u = [Último Corte] RETURN CALCULATE ( [Mora 90+], Calendario[Fecha] = u )",
            "formatString": "0.0 %;-0.0 %;0.0 %",
            "lineageTag": "8c9e08ac-c500-4cdf-a860-5d0344e55d78"
          },
          {
            "name": "Créditos Activos (último corte)",
            "displayFolder": "Último corte",
            "expression": "VAR u = [Último Corte] RETURN CALCULATE ( [Créditos Activos], Calendario[Fecha] = u )",
            "formatString": "#,0",
            "lineageTag": "69aa6080-5770-4c9b-b7b5-42807fe2c5d8"
          },
          {
            "name": "ICV 30+ hace 12 meses",
            "displayFolder": "Último corte",
            "expression": "VAR u = EDATE ( [Último Corte], -12 ) RETURN CALCULATE ( [ICV 30+], Calendario[Fecha] = u )",
            "formatString": "0.0 %;-0.0 %;0.0 %",
            "lineageTag": "ca6fbe04-7f4d-40da-a7ad-67119f2d20a6"
          },
          {
            "name": "Var ICV 30+ 12M (pp)",
            "displayFolder": "Último corte",
            "expression": "( [ICV 30+ (último corte)] - [ICV 30+ hace 12 meses] ) * 100",
            "formatString": "+0.0 \"pp\";-0.0 \"pp\"",
            "lineageTag": "5bcf1dcb-7f81-4812-a7f2-c21e6787629f"
          },
          {
            "name": "Mora 30+ cosecha",
            "displayFolder": "Análisis",
            "expression": "AVERAGE ( cosechas[pct_alguna_vez_30] )",
            "formatString": "0.0 %;-0.0 %;0.0 %",
            "lineageTag": "1fc1ab71-6d67-4cb1-a061-0da5d7bd8234"
          },
          {
